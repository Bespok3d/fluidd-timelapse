{
  "name": "timelapse",
  "title": "Timelapse",
  "version": "0.1.1",
  "author": "bespoked",
  "description": "Adds a minimal Moonraker timelapse component and enables it, so the Timelapse menu shows up in Fluidd and Mainsail. Ships its own component, so it works on stock firmware where Moonraker has none.",
  "tagline": "Enable the Timelapse menu in Fluidd & Mainsail.",
  "category": "camera",
  "channel": "stable",
  "printer_specific": false,
  "changelog": "doc/CHANGELOG.md",
  "published_at": "2025-12-05",
  "updated_at": "2026-01-08",
  "source": "https://github.com/bespok3d-org/plugin-timelapse",
  "publisher": "PLACEHOLDER",
  "provides": [
    {
      "service": "timelapse"
    }
  ],
  "require": [],
  "conflicts": [],
  "requires": {
    "capabilities": [
      "klipper-generic"
    ],
    "variables": []
  },
  "permissions": [
    "moonraker-component",
    "moonraker-config",
    "restart"
  ],
  "install": {
    "place": [
      {
        "class": "moonraker-component",
        "src": "files/moonraker/timelapse.py"
      },
      {
        "class": "moonraker-config",
        "src": "files/cfg/moonraker/timelapse.cfg"
      }
    ],
    "restart": [
      "moonraker"
    ]
  },
  "conflict_resolutions": [],
  "files": []
}
